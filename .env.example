# FilmScout environment variables
#
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to source control.

# Required — obtain a key from https://console.cloud.google.com/
# and enable the "YouTube Data API v3" for your project.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Optional — TCP port for the Flask dev server (default: 5000)
PORT=5000

# Optional — set to "true" to enable Flask debug mode (development only)
FLASK_DEBUG=false
